{
  "expo": {
    "name": "Sumolasi",
    "slug": "sumolasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sumolasi",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alfacode.sumolasi",
      "appleTeamId": "CHL73JZQ6Y",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDisplayName": "HydroMate"
      }
    },
    "android": {
      "package": "com.alfacode.sumolasi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5081E5"
        }
      ],
      "expo-localization",
      [
        "./plugins/withPodsDeploymentTarget",
        {
          "target": "15.1"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1,
          "backgroundColor": "#F6FAFD",
          "dark": {
            "image": "./assets/splash-transparent.png",
            "backgroundColor": "#0A131D"
          }
        }
      ],
      "expo-font",
      "./plugins/withWidgetMascot",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.farukemreoz.sumolasi",
          "widgets": [
            {
              "name": "WaterWidget",
              "displayName": "HydroMate",
              "description": "Track your daily water goal and add water with one tap.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/WaterWidget.js"
              }
            }
          ]
        }
      ],
      "./plugins/withSiriShortcuts",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4782662453178131~4619573641",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Reklamları ilgi alanlarına göre gösterebilmek için. İzin vermesen de uygulamanın tamamını kullanabilirsin."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2eb1305c-1314-4715-bd1f-8f7d73ed7a57"
      },
      "revenuecat": {
        "iosApiKey": "",
        "androidApiKey": ""
      },
      "ads": {
        "iosBanner": "ca-app-pub-4782662453178131/3570040846",
        "iosInterstitial": "ca-app-pub-4782662453178131/9895951057"
      },
      "legal": {
        "termsUrl": "https://farukoz1.github.io/sumolasi-legal/terms.html",
        "privacyUrl": "https://farukoz1.github.io/sumolasi-legal/privacy.html"
      }
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
