{
  "expo": {
    "name": "Sumolasi",
    "slug": "sumolasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sumolasi",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alfacode.sumolasi",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.alfacode.sumolasi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5081E5"
        }
      ],
      "expo-localization",
      [
        "./plugins/withPodsDeploymentTarget",
        {
          "target": "15.1"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.alfacode.sumolasi",
          "widgets": [
            {
              "name": "WaterWidget",
              "displayName": "Su Molası",
              "description": "Günlük su hedefini takip et, tek dokunuşla su ekle.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/WaterWidget.js"
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2eb1305c-1314-4715-bd1f-8f7d73ed7a57"
      }
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
